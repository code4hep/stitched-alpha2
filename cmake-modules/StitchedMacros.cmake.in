# StitchedMacros.cmake
# Utility functions for Stitched projects

# Must be unconditional: this file is include()-d by consumers via
# StitchedConfig.cmake, and GNUInstallDirs is idempotent.
include(GNUInstallDirs)

#[=======================================================================[.rst:
stitched_generate_dictionary
----------------------------

Thin wrapper around ROOT's ``root_generate_dictionary`` that suppresses
compiler warnings on the generated dictionary source file.  rootcling-
generated code routinely triggers ``-Wunused-variable`` (and related)
warnings that are not actionable; silencing them here keeps ``-Wall``
clean without touching every call site.

Usage is identical to ``root_generate_dictionary``::

  stitched_generate_dictionary(<DictName>
      [<header> ...]
      LINKDEF <linkdef>
      MODULE  <target>
      [OPTIONS ...]
  )

#]=======================================================================]
macro(stitched_generate_dictionary DICT_NAME)
    # Delegate all arguments verbatim to the ROOT macro.
    root_generate_dictionary(${DICT_NAME} ${ARGN})

    # ROOT generates the source as <DictName>.cxx in CMAKE_CURRENT_BINARY_DIR.
    set(_dict_src "${CMAKE_CURRENT_BINARY_DIR}/${DICT_NAME}.cxx")

    # Suppress warnings that are endemic to rootcling-generated code and are
    # not actionable (unused shadow variables, ignored attributes, etc.).
    set_source_files_properties("${_dict_src}" PROPERTIES
        COMPILE_OPTIONS "-Wno-unused-variable;-Wno-unused-parameter;-Wno-shadow;-Wno-attributes"
    )

    unset(_dict_src)
endmacro()

# Path to Stitched executables (edmWriteConfigs, edmPluginRefresh, etc.)
# This is configured at CMake time for build or install
set(STITCHED_EXECUTABLES_DIR "@STITCHED_EXECUTABLES_DIR@")
set(STITCHED_INCLUDES_DIR "@STITCHED_INCLUDES_DIR@")

# Build-tree staging area and install destination for Stitched python
# configuration. Both are part of the public consumer-facing API surface:
# they let a consumer relocate the Python tree without knowing Stitched's
# internal per-package layout.
set(STITCHED_PYTHON_BUILD_DIR "${CMAKE_BINARY_DIR}/python"
    CACHE PATH "Build-tree staging area for Stitched python configuration")
set(STITCHED_INSTALL_PYTHONDIR "python"
    CACHE PATH "Install destination, relative to the prefix, for python configuration")

# Internal helper: computes the calling directory's package path (e.g.
# "FWCore/Utilities"), relative to the top of the current project's source
# tree. Note PROJECT_SOURCE_DIR, not CMAKE_SOURCE_DIR: the latter would break
# if a consumer pulls Stitched or the example in via FetchContent/superbuild.
function(_stitched_package_path OUTVAR)
    file(RELATIVE_PATH _rel "${PROJECT_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}")
    set(${OUTVAR} "${_rel}" PARENT_SCOPE)
endfunction()

#[=======================================================================[.rst:
stitched_install_python
-----------------------

Stage and install the hand-written Python configuration for the calling
package.

.. command:: stitched_install_python

  ::

    stitched_install_python()

  Takes no arguments; operates on ``CMAKE_CURRENT_SOURCE_DIR``.

  If a ``python/`` subdirectory exists next to the calling
  ``CMakeLists.txt``, every ``.py`` file under it (recursively, so nested
  directories such as ``python/test/`` are preserved) is staged into
  ``${STITCHED_PYTHON_BUILD_DIR}/<Subsys>/<Pkg>/`` via
  ``configure_file(COPYONLY)``, so that editing or adding a file refreshes
  the build tree on the next build without a manual CMake re-run.

  A single ``install(DIRECTORY ...)`` rule is then emitted for the staged
  directory, guarded so it is only ever emitted once per directory (this is
  what avoids a double-install for packages that both ship a ``python/``
  directory and call ``stitched_generate_plugin()``, since the latter calls
  this function internally too).

  Caveat: a ``.py`` file deleted from the source tree lingers in the
  build-tree stage (and therefore keeps being installed) until the build
  directory is cleaned.

#]=======================================================================]
function(stitched_install_python)
    _stitched_package_path(_pkg)
    set(_stage "${STITCHED_PYTHON_BUILD_DIR}/${_pkg}")
    file(MAKE_DIRECTORY "${_stage}")

    if(IS_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/python")
        file(GLOB_RECURSE _py CONFIGURE_DEPENDS RELATIVE
             "${CMAKE_CURRENT_SOURCE_DIR}/python"
             "${CMAKE_CURRENT_SOURCE_DIR}/python/*.py")
        foreach(_f ${_py})
            configure_file("${CMAKE_CURRENT_SOURCE_DIR}/python/${_f}"
                           "${_stage}/${_f}" COPYONLY)
        endforeach()
        unset(_py)
    endif()

    get_directory_property(_install_rule_emitted STITCHED_PYTHON_INSTALL_RULE_EMITTED)
    if(NOT _install_rule_emitted)
        set_directory_properties(PROPERTIES STITCHED_PYTHON_INSTALL_RULE_EMITTED TRUE)
        install(DIRECTORY "${_stage}/"
                DESTINATION "${STITCHED_INSTALL_PYTHONDIR}/${_pkg}"
                FILES_MATCHING PATTERN "*.py"
                PATTERN "__pycache__" EXCLUDE)
    endif()
    unset(_install_rule_emitted)
endfunction()

#[=======================================================================[.rst:
stitched_generate_plugin
---------------------

Generate a Stitched EDM plugin library with automatic configuration generation.

.. command:: stitched_generate_plugin

  ::

    stitched_generate_plugin(
        TARGET <target_name>
        SOURCES <source1> [<source2> ...]
        LINK_LIBRARIES <lib1> [<lib2> ...]
        [INCLUDE_DIRECTORIES <dir1> [<dir2> ...]]
    )

  Creates a shared library target with the "edmplugin" prefix and generates
  Python configuration files using edmWriteConfigs.

  Arguments:
    ``TARGET``
      Name of the plugin target to create.

    ``SOURCES``
      List of source files for the plugin.

    ``LINK_LIBRARIES``
      List of libraries to link against.

    ``INCLUDE_DIRECTORIES``
      Optional list of additional include directories (beyond standard paths).

  The function will:
    - Create a shared library with the "edmplugin" prefix
    - Set up include directories for build and install interfaces
    - Link against specified libraries
    - Install the plugin library itself
    - Register the plugin for automatic project-wide plugin cache generation
      (see ``stitched_generate_plugincache``)
    - Run edmWriteConfigs to generate Python configurations
    - Stage the ``modules.py`` template alongside the generated configs
    - Delegate staging and installing of any hand-written Python files (and
      the single install rule for the whole staged directory) to
      ``stitched_install_python()``

  Note that the plugin libraries are dlopen-loaded at runtime via
  edmplugin::PluginManager and should never be referenced via
  target_link_libraries by another CMake target, so they are not part
  of the Stitched:: export set. They are built and installed as
  regular (non-exported) shared libraries.

  Example:
    ::

      file(GLOB PLUGIN_SOURCES src/*.cc)
      stitched_generate_plugin(
          TARGET MyPlugins
          SOURCES ${PLUGIN_SOURCES}
          LINK_LIBRARIES
              stitched_FWCore_Framework
              stitched_FWCore_ParameterSet
      )

#]=======================================================================]
function(stitched_generate_plugin)
    # Parse arguments
    set(options "")
    set(oneValueArgs TARGET)
    set(multiValueArgs SOURCES LINK_LIBRARIES INCLUDE_DIRECTORIES)
    cmake_parse_arguments(PLUGIN "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

    # Validate required arguments
    if(NOT PLUGIN_TARGET)
        message(FATAL_ERROR "stitched_generate_plugin: TARGET argument is required")
    endif()
    if(NOT PLUGIN_SOURCES)
        message(FATAL_ERROR "stitched_generate_plugin: SOURCES argument is required")
    endif()

    # Create the plugin library
    add_library(${PLUGIN_TARGET} SHARED ${PLUGIN_SOURCES})

    # Set up include directories
    target_include_directories(${PLUGIN_TARGET}
        PRIVATE
            ${PROJECT_SOURCE_DIR}
            ${PLUGIN_INCLUDE_DIRECTORIES}
    )

    # Link with specified libraries
    if(PLUGIN_LINK_LIBRARIES)
        target_link_libraries(${PLUGIN_TARGET}
            PUBLIC
                ${PLUGIN_LINK_LIBRARIES}
        )
    endif()

    # Set the plugin prefix
    set_target_properties(${PLUGIN_TARGET} PROPERTIES PREFIX "edmplugin")

    # Install the plugin library itself (no EXPORT or FILE_SET).
    # ARCHIVE/RUNTIME are dead: the target is always SHARED and never linked
    # against. CMAKE_INSTALL_LIBDIR is guaranteed non-empty by the
    # unconditional include(GNUInstallDirs) at the top of this file.
    install(TARGETS ${PLUGIN_TARGET}
        LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
    )

    # Register this plugin target globally so the project's plugin cache can be
    # generated automatically once all plugins have been configured (see
    # stitched_generate_plugincache() and the deferred call below).
    set_property(GLOBAL APPEND PROPERTY STITCHED_PLUGIN_TARGETS ${PLUGIN_TARGET})

    # Schedule automatic plugin cache generation, once per top-level project.
    # cmake_language(DEFER) runs the call at the end of processing
    # CMAKE_SOURCE_DIR, i.e. after every add_subdirectory() anywhere in the
    # consumer's (or Stitched's own) source tree has finished configuring, so
    # every plugin registered above via STITCHED_PLUGIN_TARGETS is guaranteed to
    # be known by the time _stitched_run_plugincache() executes. A GLOBAL
    # property guard ensures this is scheduled only once even though this
    # function may be called many times.
    #
    # NOTE: also snapshot the current (build-tree) value of
    # STITCHED_EXECUTABLES_DIR into a GLOBAL property here. Some top-level
    # CMakeLists.txt files (including Stitched's own) reassign this variable
    # later on (e.g. to the install-tree path, when generating an
    # install-tree copy of StitchedMacros.cmake). The deferred call
    # only fires after the entire top-level CMakeLists.txt body has been
    # processed, _stitched_run_plugincache() would otherwise risk to read
    # the later reassigned value.
    get_property(_stitched_plugincache_scheduled GLOBAL PROPERTY STITCHED_PLUGINCACHE_SCHEDULED)
    if(NOT _stitched_plugincache_scheduled)
        set_property(GLOBAL PROPERTY STITCHED_PLUGINCACHE_SCHEDULED TRUE)
        set_property(GLOBAL PROPERTY STITCHED_PLUGINCACHE_EXECUTABLES_DIR "${STITCHED_EXECUTABLES_DIR}")
        cmake_language(DEFER DIRECTORY ${CMAKE_SOURCE_DIR} CALL _stitched_run_plugincache)
    endif()
    unset(_stitched_plugincache_scheduled)

    # If edmWriteConfigs is a target (building Stitched), add it as a dependency
    # to ensure it's built before we try to run it
    if(TARGET edmWriteConfigs)
        add_dependencies(${PLUGIN_TARGET} edmWriteConfigs)
    endif()

    # Calculate the package path and staging directory for this package
    _stitched_package_path(_pkg)
    set(_stage "${STITCHED_PYTHON_BUILD_DIR}/${_pkg}")

    # Ensure the Python output directory exists
    file(MAKE_DIRECTORY "${_stage}")

    # Run edmWriteConfigs to generate Python configuration for this plugin library
    # The POST_BUILD command ensures this runs after the plugin is built
    add_custom_command(TARGET ${PLUGIN_TARGET} POST_BUILD
        COMMAND ${STITCHED_EXECUTABLES_DIR}/edmWriteConfigs -p $<TARGET_FILE:${PLUGIN_TARGET}>
        WORKING_DIRECTORY "${_stage}"
        COMMENT "Generating Python configs for ${PLUGIN_TARGET}"
    )

    # Stage the modules.py template alongside the generated configs
    set(_modules_py_template "${STITCHED_INCLUDES_DIR}/FWCore/ParameterSet/templates/modules.py")
    if(NOT EXISTS "${_modules_py_template}")
        message(FATAL_ERROR
            "stitched_generate_plugin: failed to find modules.py template at "
            "${_modules_py_template} (STITCHED_INCLUDES_DIR=${STITCHED_INCLUDES_DIR})")
    endif()
    configure_file("${_modules_py_template}" "${_stage}/modules.py" COPYONLY)
    unset(_modules_py_template)

    # Stage and install any hand-written Python files, plus emit the single
    # install rule for the whole staged directory (covers modules.py and the
    # generated configs above too).
    stitched_install_python()

    unset(_pkg)
    unset(_stage)
endfunction()

#[=======================================================================[.rst:
stitched_generate_plugincache
--------------------------

Generate the .edmplugincache file for Stitched EDM plugin libraries.

.. command:: stitched_generate_plugincache

  ::

    stitched_generate_plugincache(
        PLUGIN_TARGETS <target1> [<target2> ...]
        [OUTPUT_DIR <directory>]
        [CACHE_TARGET_NAME <name>]
    )

  Creates a custom command that runs edmPluginRefresh on all specified plugin
  targets to generate the .edmplugincache file, and installs the cache file.

  Note that this function is normally invoked automatically (once per project) by
  ``stitched_generate_plugin()`` (via the internal ``_stitched_run_plugincache``
  trampoline). Calling it manually will produce a CMake configure-time
  error due to duplicate call.

  Its ``OUTPUT_DIR`` and ``CACHE_TARGET_NAME`` parameters remain
  documented below and still valid for manual use outside the
  automatic flow, should that ever be needed, but they are not
  currently exposed when called from ``stitched_generate_plugin()``

  Arguments:
    ``PLUGIN_TARGETS``
      List of plugin target names to include in the cache.

    ``OUTPUT_DIR`` (optional)
      Directory where the .edmplugincache file will be generated.
      Defaults to ${CMAKE_LIBRARY_OUTPUT_DIRECTORY}.

    ``CACHE_TARGET_NAME`` (optional)
      Name for the custom target that triggers cache generation.
      Defaults to "RefreshPluginCache".

  The function will:
    - Create a custom command that runs edmPluginRefresh on all plugins
    - Create a custom target (built by default) that depends on the cache
    - Install the .edmplugincache file to the library directory
    - Automatically handle plugin targets that may not exist

  Example:
    ::

      stitched_generate_plugincache(
          PLUGIN_TARGETS
              stitched_FWCore_ModulesPlugins
              stitched_FWCore_IntegrationPlugins
              stitched_FWCore_ServicesPlugins
              MyCustomPlugins
      )

#]=======================================================================]

# Internal helper: reads all plugin targets registered via
# stitched_generate_plugin() and triggers the actual cache generation.
# Not intended to be called directly by consumers.
function(_stitched_run_plugincache)
    get_property(_stitched_all_plugin_targets GLOBAL PROPERTY STITCHED_PLUGIN_TARGETS)

    # Restore STITCHED_EXECUTABLES_DIR to the value captured when the
    # deferred call was scheduled (see stitched_generate_plugin()), in case
    # the top-level CMakeLists.txt reassigned it afterwards (e.g. to the
    # install-tree path) before this deferred call fires.
    get_property(_stitched_executables_dir GLOBAL PROPERTY STITCHED_PLUGINCACHE_EXECUTABLES_DIR)
    set(STITCHED_EXECUTABLES_DIR "${_stitched_executables_dir}")

    stitched_generate_plugincache(PLUGIN_TARGETS ${_stitched_all_plugin_targets})
endfunction()

function(stitched_generate_plugincache)
    # Parse arguments
    set(options "")
    set(oneValueArgs OUTPUT_DIR CACHE_TARGET_NAME)
    set(multiValueArgs PLUGIN_TARGETS)
    cmake_parse_arguments(CACHE "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

    # Validate required arguments
    if(NOT CACHE_PLUGIN_TARGETS)
        message(FATAL_ERROR "stitched_generate_plugincache: PLUGIN_TARGETS argument is required")
    endif()

    # Set defaults
    if(NOT CACHE_OUTPUT_DIR)
        set(CACHE_OUTPUT_DIR ${CMAKE_LIBRARY_OUTPUT_DIRECTORY})
    endif()

    if(NOT CACHE_CACHE_TARGET_NAME)
        set(CACHE_CACHE_TARGET_NAME "RefreshPluginCache")
    endif()

    # Build the command arguments and dependencies lists
    set(PLUGIN_COMMAND_ARGS "")
    set(PLUGIN_DEPENDS "")
    
    # Only add edmPluginRefresh as a dependency if it's a target (during Stitched build)
    # When using installed Stitched, edmPluginRefresh is an executable, not a target
    if(TARGET edmPluginRefresh)
        list(APPEND PLUGIN_DEPENDS edmPluginRefresh)
    endif()

    foreach(plugin_target ${CACHE_PLUGIN_TARGETS})
        # Add target file to command arguments (only if target exists)
        list(APPEND PLUGIN_COMMAND_ARGS
            "$<$<TARGET_EXISTS:${plugin_target}>:$<TARGET_FILE:${plugin_target}>>")
        
        # Add target to dependencies (only if target exists)
        list(APPEND PLUGIN_DEPENDS
            "$<$<TARGET_EXISTS:${plugin_target}>:${plugin_target}>")
    endforeach()

    # Create custom command to generate the plugin cache
    add_custom_command(
        OUTPUT "${CACHE_OUTPUT_DIR}/.edmplugincache"
        COMMAND ${STITCHED_EXECUTABLES_DIR}/edmPluginRefresh ${PLUGIN_COMMAND_ARGS}
        DEPENDS ${PLUGIN_DEPENDS}
        COMMENT "Refreshing plugin cache for edmplugin libraries"
        VERBATIM
    )

    # Add a custom target that depends on the plugin cache and is built by default
    add_custom_target(${CACHE_CACHE_TARGET_NAME} ALL
        DEPENDS "${CACHE_OUTPUT_DIR}/.edmplugincache"
    )

    # Install the plugin cache file
    install(FILES "${CACHE_OUTPUT_DIR}/.edmplugincache"
            TYPE LIB)  # Automatically uses CMAKE_INSTALL_LIBDIR

endfunction()
